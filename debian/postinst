#!/bin/sh
set -e

# Rutas de la instalación: código en /opt/pi-console, datos en /var/lib/pi-console (que sobrevive a las actualizaciones) y un enlace de compatibilidad para el módulo auth.
# EN: Installation paths: code in /opt/pi-console, data in /var/lib/pi-console (which survives upgrades) and a compatibility link for the auth module.
PI_HOME="/opt/pi-console"
DATA_DIR="/var/lib/pi-console"
AUTH_LINK="/opt/pi-console-auth"

echo "pi-console: configuring installation..."

# ── 1. Crear usuario del sistema ──────────────────────────────────────────────
# EN: Step 1: create the unprivileged system user that runs every service (no home, no login shell).
if ! id -u pi-console >/dev/null 2>&1; then
    useradd --system --no-create-home --shell /usr/sbin/nologin pi-console
    echo "  system user pi-console created"
fi

# ── 2. Directorio de datos persistentes (nunca tocado por dpkg) ───────────────
# EN: Step 2: persistent data folder (/var/lib/pi-console). dpkg never touches it, so users and settings survive upgrades.
mkdir -p "$DATA_DIR"
chown pi-console:pi-console "$DATA_DIR"
chmod 750 "$DATA_DIR"

# ── 2b. Teleporter: directorio de trabajo + regla sudo para el panel de admin ─
# El panel (usuario pi-console) solo puede ejecutar estas dos acciones como root.
# EN: Step 2b: Teleporter work folder + sudo rule. The panel (user pi-console) may run only these two actions as root.
install -d -m 700 -o pi-console -g pi-console "$DATA_DIR/teleporter"
if [ -d /etc/sudoers.d ] && command -v visudo >/dev/null 2>&1; then
    # La regla se escribe primero en un archivo temporal y se valida con visudo: una regla inválida bloquearía sudo en todo el sistema.
    # EN: The rule is written to a temp file first and validated with visudo: an invalid rule would break sudo on the whole system.
    SUDOERS_TMP=$(mktemp)
    cat > "$SUDOERS_TMP" <<'SUDOEOF'
# Pi Console: the admin panel runs backup/restore as root
pi-console ALL=(root) NOPASSWD: /usr/local/bin/teleporter.sh gui-backup, /usr/local/bin/teleporter.sh gui-restore *
SUDOEOF
    if visudo -cf "$SUDOERS_TMP" >/dev/null 2>&1; then
        install -m 0440 -o root -g root "$SUDOERS_TMP" /etc/sudoers.d/pi-console-teleporter
        echo "  sudo rule for teleporter installed"
    else
        echo "  WARNING: invalid sudo rule, backup from the panel is disabled"
    fi
    rm -f "$SUDOERS_TMP"
else
    echo "  WARNING: sudo is not installed; backup from the panel is disabled (use 'teleporter' on the command line)"
fi

# ── 3. Symlink auth compartido → datos persistentes ───────────────────────────
# EN: Step 3: shared auth links, so the old path /opt/pi-console-auth keeps pointing at the module and the persistent data.
mkdir -p "$AUTH_LINK"
ln -sf "$PI_HOME/auth/auth.py"        "$AUTH_LINK/auth.py"        2>/dev/null || true
ln -sf "$DATA_DIR/users.json"         "$AUTH_LINK/users.json"     2>/dev/null || true
ln -sf "$DATA_DIR/sessions.json"      "$AUTH_LINK/sessions.json"  2>/dev/null || true
chown -h pi-console:pi-console "$AUTH_LINK"/* 2>/dev/null || true
chown pi-console:pi-console "$AUTH_LINK"

# ── 4. Permisos de directorios de código ─────────────────────────────────────
# EN: Step 4: ownership and permissions of the code folders.
chown -R pi-console:pi-console "$PI_HOME"
chmod 755 "$PI_HOME"
for module in wol-console nut-monitor net-monitor proxmox-monitor overview auth; do
    chown pi-console:pi-console "$PI_HOME/$module"
    chmod 755 "$PI_HOME/$module"
done

# ttyUSB0 para NUT (UPS por serial)
# EN: ttyUSB0 for NUT (serial UPS): the service user needs the dialout group to open the port.
if getent group dialout >/dev/null 2>&1; then
    usermod -aG dialout pi-console 2>/dev/null || true
fi

# Raspberry Pi: leer el estado de la fuente (vcgencmd get_throttled) para el aviso de subtensión
# EN: Raspberry Pi only: read the power supply state (vcgencmd get_throttled) for the under-voltage warning; needs the video group.
if grep -qa "Raspberry Pi" /proc/device-tree/model 2>/dev/null && getent group video >/dev/null 2>&1; then
    usermod -aG video pi-console 2>/dev/null || true
fi

# ── 4b. Migracion: el servicio del dashboard se llamaba "nut-monitor", igual que el
# servicio upsmon de NUT (paquete nut-client). Nuestro archivo en /etc/systemd/system
# tapaba el de NUT, y nut.target arrancaba el dashboard en lugar de upsmon.
# EN: Step 4b, migration: the dashboard service used to be called "nut-monitor", the same as NUT's upsmon service (package nut-client). Our file in /etc/systemd/system hid NUT's, and nut.target started the dashboard instead of upsmon.
migrate_legacy_nut_unit() {
    legacy="/etc/systemd/system/nut-monitor.service"
    [ -f "$legacy" ] || return 0
    grep -q "Pi Console" "$legacy" 2>/dev/null || return 0    # no es el nuestro: no tocar
    echo "  migrating old nut-monitor service -> pi-console-ups"
    systemctl stop nut-monitor 2>/dev/null || true
    systemctl disable nut-monitor 2>/dev/null || true
    rm -f "$legacy" /etc/systemd/system/multi-user.target.wants/nut-monitor.service
    systemctl daemon-reload 2>/dev/null || true
    systemctl reset-failed nut-monitor 2>/dev/null || true
    # devolver el servicio upsmon de NUT si hay un MONITOR configurado
    if [ -f /etc/nut/upsmon.conf ] && grep -qE '^[[:space:]]*MONITOR[[:space:]]' /etc/nut/upsmon.conf; then
        if systemctl cat nut-monitor >/dev/null 2>&1; then
            systemctl enable nut-monitor 2>/dev/null || true
            systemctl restart nut-monitor 2>/dev/null || true
            echo "  nut-monitor service (NUT upsmon) restored"
        fi
    fi
}
migrate_legacy_nut_unit

# ── 5. Instalar archivos de servicio systemd ──────────────────────────────────
# EN: Step 5: install the systemd unit files. One template for the 6 services; they restart on failure after 5 s and log to the journal.
install_service() {
    name="$1" desc="$2" module="$3" script="$4"
    cat > "/etc/systemd/system/${name}.service" <<EOF
[Unit]
Description=Pi Console — ${desc}
After=network.target
Wants=network.target

[Service]
Type=simple
User=pi-console
WorkingDirectory=${PI_HOME}/${module}
# Variables opcionales para todos los servicios (p. ej. PICONSOLE_SECURE_COOKIE=1); el archivo puede no existir.
# EN: Optional variables for all the services (e.g. PICONSOLE_SECURE_COOKIE=1); the file may not exist.
EnvironmentFile=-/etc/default/pi-console
ExecStart=/usr/bin/python3 ${PI_HOME}/${module}/${script}
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=${name}

[Install]
WantedBy=multi-user.target
EOF
    echo "  service ${name} installed"
}

install_service "wol-console"     "WOL Console"     "wol-console"     "server.py"
install_service "pi-console-ups" "UPS Monitor"      "nut-monitor"     "server.py"
install_service "admin-panel"     "Admin Panel"      "auth"            "admin_panel.py"
install_service "net-monitor"     "Net Monitor"      "net-monitor"     "server.py"
install_service "proxmox-monitor" "Proxmox Monitor"  "proxmox-monitor" "server.py"
install_service "pi-console-overview" "Overview" "overview" "server.py"

# ── 6. Nginx ──────────────────────────────────────────────────────────────────
# EN: Step 6: nginx. The default site is removed (it would take port 80) and the Pi Console one is enabled.
if [ -f /etc/nginx/sites-enabled/default ]; then
    rm -f /etc/nginx/sites-enabled/default
fi
ln -sf /etc/nginx/sites-available/pi-console.conf \
       /etc/nginx/sites-enabled/pi-console.conf 2>/dev/null || true

# ── 7. Migrar datos desde rutas antiguas (solo una vez) ──────────────────────
# Si los datos estaban en la ruta antigua /opt/pi-console/auth/ o en backup,
# los movemos a /var/lib/pi-console/ — solo si aún no existen ahí.
# EN: Step 7: migrate data from old paths (only once). If the data was in the old /opt/pi-console/auth/ path or in a backup, it is moved to /var/lib/pi-console/ — only if it does not exist there yet.
BACKUP_DIR="/var/backups/pi-console"

if [ ! -f "$DATA_DIR/users.json" ]; then
    # Intentar migrar desde backup (upgrade desde versión anterior)
    latest_users=$(ls -t "$BACKUP_DIR/users.json".*.bak 2>/dev/null | head -1)
    if [ -n "$latest_users" ]; then
        cp "$latest_users" "$DATA_DIR/users.json"
        chown pi-console:pi-console "$DATA_DIR/users.json"
        chmod 600 "$DATA_DIR/users.json"
        echo "  users migrated from backup: $latest_users"
    else
        # Fresh install: crear admin/admin
        # Instalación nueva: usuario admin/admin con cambio de contraseña obligatorio en el primer ingreso. El hash antiguo se migra a scrypt en el primer login.
        # EN: Fresh install: admin/admin user with a mandatory password change at first login. The old hash is migrated to scrypt on the first login.
        python3 -c "
import hashlib, json, time
salt = 'pi-console-salt-change-me'
pw   = hashlib.sha256(f'{salt}:admin'.encode()).hexdigest()
users = {'admin': {'password_hash': pw, 'permissions': {
    'wol':'admin','nut':'admin','net':'admin','pve':'admin'
}, 'created': int(time.time()), 'must_change_password': True}}
print(json.dumps(users, indent=2))
" > "$DATA_DIR/users.json"
        chown pi-console:pi-console "$DATA_DIR/users.json"
        chmod 600 "$DATA_DIR/users.json"
        echo "  users.json created (admin / admin)"
    fi
else
    echo "  existing users kept in $DATA_DIR"
fi

# Migrar sessions.json si existe en backup y no hay uno nuevo
if [ ! -f "$DATA_DIR/sessions.json" ]; then
    latest_sess=$(ls -t "$BACKUP_DIR/sessions.json".*.bak 2>/dev/null | head -1)
    if [ -n "$latest_sess" ]; then
        cp "$latest_sess" "$DATA_DIR/sessions.json"
        chown pi-console:pi-console "$DATA_DIR/sessions.json"
    else
        echo "{}" > "$DATA_DIR/sessions.json"
        chown pi-console:pi-console "$DATA_DIR/sessions.json"
    fi
fi

# ── 7b. Restaurar datos de los módulos desde backup (solo si faltan) ──────────
# Dispositivos WOL, servidores UPS, historial, hosts, config y clusters viven
# dentro de /opt/pi-console. Si no existen (reinstalación tras remove/purge),
# se recuperan del backup. Nunca se sobrescribe un archivo existente.
# history.db: se usa el respaldo MÁS GRANDE (el más reciente puede ser una base
# casi vacía creada por un reinicio previo); el resto, el más reciente.
# EN: Step 7b: restore module data from backup (only if missing). WOL devices, UPS servers, history, hosts, config and clusters live inside /opt/pi-console; after a remove/purge + reinstall they are recovered from the backup. An existing file is never overwritten. For history.db the LARGEST backup is used (the newest may be an almost empty database created by a previous restart); for the rest, the newest.
if [ -d "$BACKUP_DIR" ]; then
    MODULE_FILES="
wol-console/devices.json:devices.json
nut-monitor/servers.json:servers.json
nut-monitor/history.db:history.db
net-monitor/hosts.json:hosts.json
net-monitor/config.json:config.json
proxmox-monitor/clusters.json:clusters.json
proxmox-monitor/history.json:history.json
"
    printf '%s\n' "$MODULE_FILES" | grep -v '^$' | while IFS=: read -r rel_path base; do
        dest="$PI_HOME/$rel_path"
        [ -f "$dest" ] && continue
        if [ "$base" = "history.db" ]; then
            src=$(ls -S "$BACKUP_DIR/${base}".*.bak 2>/dev/null | head -1)
        else
            src=$(ls -t "$BACKUP_DIR/${base}".*.bak 2>/dev/null | head -1)
        fi
        if [ -n "$src" ]; then
            mkdir -p "$(dirname "$dest")"
            cp "$src" "$dest"
            chown pi-console:pi-console "$dest"
            echo "  restored: $rel_path (from $src)"
        fi
    done
fi

# ── 8. Recargar y habilitar servicios ─────────────────────────────────────────
# EN: Step 8: reload systemd, then enable and (re)start the services and reload nginx if its configuration is valid.
systemctl daemon-reload

for svc in wol-console pi-console-ups admin-panel net-monitor proxmox-monitor pi-console-overview; do
    systemctl enable "$svc" 2>/dev/null || true
    systemctl restart "$svc" 2>/dev/null || true
    echo "  $svc enabled"
done

if nginx -t -q 2>/dev/null; then
    systemctl enable nginx 2>/dev/null || true
    systemctl reload nginx 2>/dev/null || systemctl restart nginx 2>/dev/null || true
    echo "  nginx reloaded"
else
    echo "  WARNING: nginx -t failed, check the configuration manually"
fi

echo ""
echo "╔════════════════════════════════════════════════╗"
# Mensaje final con la URL de acceso.
# EN: Final message with the access URL.
echo "║  Pi Console installed successfully             ║"
echo "║  URL: http://$(hostname -I | awk '{print $1}')                  ║"
echo "║  Initial user: admin / admin                   ║"
echo "║  (change the password at first login)          ║"
echo "╚════════════════════════════════════════════════╝"
