#!/bin/bash
set -e

echo "labtower: stopping services..."
# Detiene y deshabilita los servicios antes de quitar los archivos (|| true: si alguno no existe, no se aborta).
# EN: Stop and disable the services before removing the files (|| true: if one does not exist, it does not abort).
for svc in labtower-wol labtower-ups labtower-auth labtower-net labtower-pve labtower-nas labtower-dns labtower-wan labtower-vpn labtower-uptime labtower-overview wol-console admin-panel net-monitor proxmox-monitor nas-monitor dns-monitor wan-monitor vpn-monitor; do
    systemctl stop "$svc" 2>/dev/null || true
    systemctl disable "$svc" 2>/dev/null || true
done

# Copia final de los datos antes de DESINSTALAR (al actualizar ya la hizo preinst: no se duplica). Se conservan las copias más nuevas.
# Cada archivo se lee como el usuario del servicio (root no sigue enlaces dentro de carpetas que controla el servicio).
# EN: Final copy of the data before UNINSTALLING (on upgrade preinst already made it: no duplicate). The newest copies are kept.
#     Each file is read as the service user (root does not follow links inside folders the service controls).
BACKUP_DIR="/var/backups/labtower"
STAMP=$(date +%Y%m%d_%H%M%S)
# ES: Quién es dueño de cada carpeta de datos (un usuario del sistema por módulo). Antes de actualizar, los datos pueden seguir siendo de «labtower».
# EN: Who owns each data folder (one system user per module). Before upgrading, the data may still belong to "labtower".
user_of() {
    case "$(basename "$(dirname "$1")")" in
        auth|teleporter) echo labtower-auth;; wol-console) echo labtower-wol;; nut-monitor) echo labtower-nut;;
        net-monitor) echo labtower-net;; proxmox-monitor) echo labtower-pve;; nas-monitor) echo labtower-nas;;
        dns-monitor) echo labtower-dns;; wan-monitor) echo labtower-wan;; vpn-monitor) echo labtower-vpn;; uptime-monitor) echo labtower-uptime;; overview) echo labtower-overview;; *) echo labtower;;
    esac
}
if [ "$1" = remove ] && command -v runuser >/dev/null 2>&1; then
    echo "labtower: final data backup..."
    mkdir -p "$BACKUP_DIR"; chmod 700 "$BACKUP_DIR"
    for f in \
        /var/lib/labtower/auth/users.json \
        /var/lib/labtower/users.json \
        /var/lib/labtower/wol-console/devices.json \
        /var/lib/labtower/nut-monitor/servers.json \
        /var/lib/labtower/nut-monitor/history.db \
        /var/lib/labtower/net-monitor/hosts.json \
        /var/lib/labtower/net-monitor/config.json \
        /var/lib/labtower/net-monitor/switches.json \
        /var/lib/labtower/net-monitor/switches.db \
        /var/lib/labtower/net-monitor/aps.json \
        /var/lib/labtower/net-monitor/macs.json \
        /var/lib/labtower/proxmox-monitor/clusters.json \
        /var/lib/labtower/nas-monitor/nas.json \
        /var/lib/labtower/dns-monitor/dns.json \
        /var/lib/labtower/wan-monitor/wan.json \
        /var/lib/labtower/vpn-monitor/vpn.json \
        /var/lib/labtower/uptime-monitor/uptime.json
    do
        u=$(user_of "$f"); id -u "$u" >/dev/null 2>&1 || continue
        if runuser -u "$u" -- test -f "$f" 2>/dev/null && ! runuser -u "$u" -- test -L "$f" 2>/dev/null; then
            out="$BACKUP_DIR/$(basename "$f").${STAMP}.bak"
            (umask 077; runuser -u "$u" -- cat -- "$f" > "$out") 2>/dev/null || rm -f "$out"
        fi
    done
    echo "labtower: data saved in $BACKUP_DIR"
fi
# ES: Limpieza: de cada archivo se conservan las KEEP_BAK copias más nuevas (el nombre lleva la fecha, así que el orden alfabético es el
#     cronológico) y, de history.db, también la más grande, que es la que usa la restauración. Solo se tocan archivos <nombre>.<fecha>.bak.
# EN: Cleanup: of each file the KEEP_BAK newest copies are kept (the name carries the date, so alphabetical order is chronological) and, of
#     history.db, also the largest, which is the one the restore uses. Only <name>.<date>.bak files are touched.
KEEP_BAK=5
prune_bak() {
    [ -d "$1" ] || return 0
    find "$1" -maxdepth 1 -type f -name '*.[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9].bak' -printf '%f\n' \
        | sed -n 's/^\([A-Za-z0-9._-]*\)\.[0-9]\{8\}_[0-9]\{6\}\.bak$/\1/p' | sort -u | while read -r name; do
        keep_big=""
        [ "$name" = history.db ] && keep_big=$(find "$1" -maxdepth 1 -type f -name "$name.*.bak" -printf '%s %f\n' | sort -nr | head -1 | cut -d' ' -f2)
        find "$1" -maxdepth 1 -type f -name "$name.[0-9]*_[0-9]*.bak" -printf '%f\n' | sort -r | tail -n +$((KEEP_BAK + 1)) | while read -r f; do
            [ "$f" = "$keep_big" ] || rm -f -- "$1/$f"
        done
    done
}
prune_bak "$BACKUP_DIR"
