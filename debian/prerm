#!/bin/bash
set -e

echo "labtower: stopping services..."
# Detiene y deshabilita los servicios antes de quitar los archivos (|| true: si alguno no existe, no se aborta).
# EN: Stop and disable the services before removing the files (|| true: if one does not exist, it does not abort).
for svc in wol-console labtower-ups admin-panel net-monitor proxmox-monitor nas-monitor labtower-overview; do
    systemctl stop "$svc" 2>/dev/null || true
    systemctl disable "$svc" 2>/dev/null || true
done

# Copia final de los datos antes de desinstalar; nunca se borran los respaldos en /var/backups.
# Cada archivo se lee como el usuario del servicio (root no sigue enlaces dentro de carpetas que controla el servicio).
# EN: Final copy of the data before uninstalling; backups in /var/backups are never deleted.
#     Each file is read as the service user (root does not follow links inside folders the service controls).
echo "labtower: final data backup..."
BACKUP_DIR="/var/backups/labtower"
STAMP=$(date +%Y%m%d_%H%M%S)
if id -u labtower >/dev/null 2>&1 && command -v runuser >/dev/null 2>&1; then
    mkdir -p "$BACKUP_DIR"; chmod 700 "$BACKUP_DIR"
    for f in \
        /var/lib/labtower/users.json \
        /var/lib/labtower/wol-console/devices.json \
        /var/lib/labtower/nut-monitor/servers.json \
        /var/lib/labtower/nut-monitor/history.db \
        /var/lib/labtower/net-monitor/hosts.json \
        /var/lib/labtower/net-monitor/config.json \
        /var/lib/labtower/proxmox-monitor/clusters.json \
        /var/lib/labtower/nas-monitor/nas.json
    do
        if runuser -u labtower -- test -f "$f" 2>/dev/null && ! runuser -u labtower -- test -L "$f" 2>/dev/null; then
            out="$BACKUP_DIR/$(basename "$f").${STAMP}.bak"
            (umask 077; runuser -u labtower -- cat -- "$f" > "$out") 2>/dev/null || rm -f "$out"
        fi
    done
    echo "labtower: data saved in $BACKUP_DIR"
fi
