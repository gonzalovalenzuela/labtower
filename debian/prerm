#!/bin/bash
set -e

echo "pi-console: stopping services..."
# Detiene y deshabilita los 5 servicios antes de quitar los archivos (|| true: si alguno no existe, no se aborta).
# EN: Stop and disable the 5 services before removing the files (|| true: if one does not exist, it does not abort).
for svc in wol-console pi-console-ups admin-panel net-monitor proxmox-monitor pi-console-overview; do
    systemctl stop "$svc" 2>/dev/null || true
    systemctl disable "$svc" 2>/dev/null || true
done

# Hacer backup final antes de desinstalar
echo "pi-console: final data backup..."
# Copia final de los datos antes de desinstalar; nunca se borran los respaldos en /var/backups.
# EN: Final copy of the data before uninstalling; backups in /var/backups are never deleted.
BACKUP_DIR="/var/backups/pi-console"
STAMP=$(date +%Y%m%d_%H%M%S)
mkdir -p "$BACKUP_DIR"

for f in \
    /opt/pi-console/auth/users.json \
    /opt/pi-console/auth/sessions.json \
    /opt/pi-console/wol-console/devices.json \
    /opt/pi-console/nut-monitor/servers.json \
    /opt/pi-console/nut-monitor/history.db \
    /opt/pi-console/net-monitor/hosts.json \
    /opt/pi-console/net-monitor/config.json \
    /opt/pi-console/proxmox-monitor/clusters.json \
    /opt/pi-console/proxmox-monitor/history.json
do
    [ -f "$f" ] && cp "$f" "$BACKUP_DIR/$(basename $f).${STAMP}.bak"
done
echo "pi-console: data saved in $BACKUP_DIR"
