# LabTower — automatic backup over SFTP, every day at 03:17.
# It does nothing until SFTP_USER is set in /etc/labtower/backup.conf (see: sudo labtower-sftp-backup setup).
# Result: sudo labtower-sftp-backup status   |   log: journalctl -t labtower-sftp-backup
# ES: Respaldo automático de LabTower por SFTP, todos los días a las 03:17. No hace nada hasta que se complete SFTP_USER.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
17 3 * * * root [ -x /usr/local/bin/labtower-sftp-backup ] && /usr/local/bin/labtower-sftp-backup run
