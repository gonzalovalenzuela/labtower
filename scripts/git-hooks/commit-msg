#!/bin/sh
# Quita de cada mensaje de commit las referencias a Claude: la línea «Claude-Session:», un enlace de sesión y «Co-Authored-By: Claude …».
# Para permitirlas a propósito: LABTOWER_ALLOW_CLAUDE_SESSION=1 git commit …
# Activar en un clon: git config core.hooksPath scripts/git-hooks
# EN: Strips Claude references from every commit message: the "Claude-Session:" trailer, a session link and "Co-Authored-By: Claude …".
#     To allow them on purpose: LABTOWER_ALLOW_CLAUDE_SESSION=1 git commit …   Enable in a clone: git config core.hooksPath scripts/git-hooks
[ "${LABTOWER_ALLOW_CLAUDE_SESSION:-0}" = "1" ] && exit 0
f="$1"
tmp="$(mktemp)" || exit 0
grep -v -i -E '^(claude-session:|https?://claude\.ai/code/session|co-authored-by:.*(claude|anthropic))' "$f" > "$tmp" || true
# quita líneas en blanco sobrantes al final / drop trailing blank lines
sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}' "$tmp" > "$f"
rm -f "$tmp"
exit 0
