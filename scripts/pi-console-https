#!/bin/bash
# pi-console-https — activa o desactiva HTTPS (puerto 443) para Pi Console.
# EN: pi-console-https — turn HTTPS (port 443) on or off for Pi Console.
#
#   sudo pi-console-https enable [--redirect] [--cert FILE --key FILE] [--name HOST]
#   sudo pi-console-https disable
#   pi-console-https status
#
# Sin --cert/--key se crea un certificado AUTOFIRMADO (válido 825 días) en /etc/pi-console/tls/: el navegador avisará una vez; con una CA propia
# o Let's Encrypt (--cert/--key) no avisa. Con --redirect, el puerto 80 redirige a HTTPS, las cookies de sesión pasan a «Secure» y se envía HSTS.
# EN: Without --cert/--key a SELF-SIGNED certificate (825 days) is created in /etc/pi-console/tls/: the browser warns once; with your own CA
#     or Let's Encrypt (--cert/--key) it does not. With --redirect, port 80 redirects to HTTPS, session cookies become "Secure" and HSTS is sent.
set -uo pipefail

CONF_DIR="${PICONSOLE_CONF_DIR:-/etc/pi-console}"
TLS_DIR="$CONF_DIR/tls"
HTTPS_D="$CONF_DIR/https.d"
HTTP_EXTRA_D="$CONF_DIR/http-extra.d"
DEFAULTS="${PICONSOLE_DEFAULTS:-/etc/default/pi-console}"
SERVICES="wol-console pi-console-ups admin-panel net-monitor proxmox-monitor pi-console-overview"
SKIP_SYSTEM="${PICONSOLE_HTTPS_SKIP_SYSTEM:-0}"   # 1 = no nginx/systemctl (tests)

die() { echo "Error: $*" >&2; exit 1; }
need_root() { [ "$SKIP_SYSTEM" = 1 ] || [ "$(id -u)" -eq 0 ] || die "needs root: sudo pi-console-https $*"; }

nginx_apply() {  # nginx -t, then reload; on failure restore the saved files
  [ "$SKIP_SYSTEM" = 1 ] && return 0
  if nginx -t >/dev/null 2>&1; then systemctl reload nginx 2>/dev/null || systemctl restart nginx; return 0; fi
  nginx -t 2>&1 | tail -5 >&2; return 1
}

set_cookie_secure() {  # on|off  (PICONSOLE_SECURE_COOKIE in /etc/default/pi-console)
  local v="$1" tmp
  tmp=$(mktemp) || return 1
  [ -f "$DEFAULTS" ] && grep -v '^PICONSOLE_SECURE_COOKIE=' "$DEFAULTS" > "$tmp" || true
  [ "$v" = on ] && echo "PICONSOLE_SECURE_COOKIE=1" >> "$tmp"
  install -m 0644 -o root -g root "$tmp" "$DEFAULTS"; rm -f "$tmp"
  [ "$SKIP_SYSTEM" = 1 ] || for s in $SERVICES; do systemctl try-restart "$s" 2>/dev/null || true; done
}

# ¿El certificado existente es uno autofirmado nuestro de versiones anteriores (sin serverAuth)? Entonces se regenera una vez. Los certificados propios (--cert) no se tocan.
# EN: Is the existing certificate a self-signed one of ours from earlier versions (without serverAuth)? Then it is regenerated once. Your own certificates (--cert) are never touched.
_old_selfsigned() {
  local f="$TLS_DIR/server.crt"
  [ -s "$f" ] || return 1
  [ "$(openssl x509 -in "$f" -noout -subject 2>/dev/null | sed 's/^subject= *//')" = "$(openssl x509 -in "$f" -noout -issuer 2>/dev/null | sed 's/^issuer= *//')" ] || return 1
  openssl x509 -in "$f" -noout -ext extendedKeyUsage 2>/dev/null | grep -q "TLS Web Server Authentication" && return 1
  return 0
}

cmd_enable() {
  need_root enable
  local cert="" key="" redirect=0 name
  name="$(hostname -f 2>/dev/null || hostname)"
  while [ $# -gt 0 ]; do case "$1" in
    --redirect) redirect=1;;
    --cert) cert="${2:-}"; shift;;
    --key)  key="${2:-}"; shift;;
    --name) name="${2:-}"; shift;;
    *) die "unknown option: $1";; esac; shift; done
  [[ "$name" =~ ^[A-Za-z0-9.-]{1,253}$ ]] || die "invalid --name"
  mkdir -p "$TLS_DIR" "$HTTPS_D" "$HTTP_EXTRA_D"; chmod 700 "$TLS_DIR"
  if [ -n "$cert$key" ]; then
    [ -r "$cert" ] && [ -r "$key" ] || die "--cert and --key must both be readable files"
    openssl x509 -in "$cert" -noout 2>/dev/null || die "$cert is not a valid certificate"
    openssl pkey -in "$key" -noout 2>/dev/null || die "$key is not a valid private key"
    [ "$(openssl x509 -in "$cert" -noout -pubkey 2>/dev/null)" = "$(openssl pkey -in "$key" -pubout 2>/dev/null)" ] || die "the key does not match the certificate"
    install -m 0644 "$cert" "$TLS_DIR/server.crt"; install -m 0600 "$key" "$TLS_DIR/server.key"
  elif [ ! -s "$TLS_DIR/server.crt" ] || [ ! -s "$TLS_DIR/server.key" ] || _old_selfsigned; then
    # iOS/macOS exigen SAN + «Extended Key Usage: serverAuth» (y ≤ 825 días); sin ellos Safari dice «no confiable» aunque instales el certificado.
    # EN: iOS/macOS require SAN + "Extended Key Usage: serverAuth" (and ≤ 825 days); without them Safari says "not trusted" even after installing the certificate.
    local san="DNS:$name,DNS:localhost" ip
    for ip in $(hostname -I 2>/dev/null); do san="$san,IP:$ip"; done
    ( umask 077; openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 825 -subj "/CN=$name" \
        -addext "subjectAltName=$san" -addext "extendedKeyUsage=serverAuth" -addext "keyUsage=digitalSignature,keyAgreement" \
        -addext "basicConstraints=critical,CA:TRUE" \
        -keyout "$TLS_DIR/server.key" -out "$TLS_DIR/server.crt" 2>/dev/null ) || die "could not create the certificate"
    chmod 644 "$TLS_DIR/server.crt"
    echo "Self-signed certificate created: $TLS_DIR/server.crt (install it on each device and trust it; re-install it if you had an older one)"
  fi
  local hsts=""
  [ "$redirect" = 1 ] && hsts='add_header Strict-Transport-Security "max-age=15552000" always;'
  cat > "$HTTPS_D/443.conf" <<CONF
# Generado por pi-console-https — no editar a mano (usa «pi-console-https disable» para quitarlo).
# EN: Generated by pi-console-https — do not edit by hand (use "pi-console-https disable" to remove it).
server {
    listen 443 ssl;
    server_name _;
    server_tokens off;
    ssl_certificate     $TLS_DIR/server.crt;
    ssl_certificate_key $TLS_DIR/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:piconsole_ssl:2m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;
    access_log /var/log/nginx/access.log combined buffer=64k flush=5m;
    $hsts
    include snippets/pi-console-site.conf;
}
CONF
  if [ "$redirect" = 1 ]; then
    printf '# Generado por pi-console-https\nreturn 301 https://$host$request_uri;\n' > "$HTTP_EXTRA_D/redirect.conf"
  else rm -f "$HTTP_EXTRA_D/redirect.conf"; fi
  if ! nginx_apply; then
    rm -f "$HTTPS_D/443.conf" "$HTTP_EXTRA_D/redirect.conf"; nginx_apply || true
    die "nginx rejected the configuration — HTTPS was not enabled"
  fi
  [ "$redirect" = 1 ] && set_cookie_secure on || set_cookie_secure off
  echo "HTTPS enabled: https://$name/  ($([ "$redirect" = 1 ] && echo "port 80 redirects to HTTPS, Secure cookies + HSTS" || echo "port 80 still serves HTTP"))"
}

cmd_disable() {
  need_root disable
  rm -f "$HTTPS_D/443.conf" "$HTTP_EXTRA_D/redirect.conf"
  nginx_apply || die "nginx rejected the configuration"
  set_cookie_secure off
  echo "HTTPS disabled (certificate kept in $TLS_DIR). Clear the browser's HSTS entry if you used --redirect."
}

cmd_status() {
  if [ -f "$HTTPS_D/443.conf" ]; then echo "HTTPS: enabled"; else echo "HTTPS: disabled"; fi
  [ -f "$HTTP_EXTRA_D/redirect.conf" ] && echo "HTTP→HTTPS redirect: yes" || echo "HTTP→HTTPS redirect: no"
  [ -s "$TLS_DIR/server.crt" ] && openssl x509 -in "$TLS_DIR/server.crt" -noout -subject -enddate 2>/dev/null
  return 0
}

case "${1:-}" in
  enable)  shift; cmd_enable "$@";;
  disable) cmd_disable;;
  status)  cmd_status;;
  *) sed -n 2,12p "$0" | sed 's/^# \{0,1\}//'; [ -z "${1:-}" ] || exit 1;;
esac
